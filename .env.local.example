# Copy to .env.local. Local dev needs NOTHING in here: the browser calls /api/* on this same
# origin and next.config.ts rewrites it to the API host (same-origin deployment).
#
# Do NOT set NEXT_PUBLIC_API_BASE_URL. It overrides the "/api" proxy path and points the browser
# straight at the API host, re-introducing the cross-origin setup the proxy removes — the
# cross-domain password post that got this deployment flagged by Chrome's password protection,
# plus SameSite=None and preflight. A bare value like "8000" is not a URL at all and resolves
# against the page, giving /8000/auth/login -> 404. (.env.local.bak still contains exactly that.)


# --- Runtime ---------------------------------------------------------------
# Server-side only: read at request time by the rewrite in next.config.ts, never shipped to the
# browser (hence no NEXT_PUBLIC_ prefix). Defaults to http://localhost:8000; set it only when the
# API lives somewhere else.
# API_ORIGIN=http://localhost:8000


# --- E2E (Playwright) ------------------------------------------------------
# All optional; the defaults below are what `npm run e2e` uses. The suite needs the API actually
# running — global-setup fails loudly with a reset hint rather than letting the journey fail later.

# The Next.js app under test.
# E2E_BASE_URL=http://localhost:3000

# The API, called DIRECTLY by global-setup (not through the /api proxy) to provision the admin.
# E2E_API_URL=http://localhost:8000

# The admin the journey signs in as. On a pristine database global-setup creates it via
# POST /auth/setup; otherwise it must already be able to sign in.
# E2E_ADMIN_EMAIL=e2e-admin@example.com
# E2E_ADMIN_PASSWORD=e2e-password-123
